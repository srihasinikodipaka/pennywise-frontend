# Backend API Base URL
# In local development: leave as http://localhost:8080/api or /api (when using Vite proxy)
# In production (Render Static Site): set to your deployed backend Web Service URL
# Example: https://pennywise-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api
